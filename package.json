{
  "name": "pixmix",
  "version": "0.1.0",
  "description": "Keyed, reversible pixel scrambling that keeps images valid and their metadata intact",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "exports": {
    ".": "./src/index.js",
    "./encoder": "./src/encoder.js",
    "./decoder": "./src/decoder.js",
    "./browser": "./src/browser/index.js",
    "./plugins/sharp": "./src/plugins/sharp.js",
    "./plugins/browser": "./src/plugins/browser.js",
    "./watermarks": "./src/watermark/index.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "native/jxl/pkg",
    "native/libjxl/pkg",
    "watermarks"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "fuzz": "node test/fuzz/run.js",
    "serve": "npm run build && node server/server.js",
    "test:browser": "npm run build && node --test --test-concurrency=1 test/e2e/*.test.js",
    "serve:lan": "npm run build && HOST=0.0.0.0 node server/server.js",
    "watermarks": "node scripts/watermarks.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "jpeg-js": "^0.4.4",
    "omggif": "^1.0.10",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4"
  },
  "bin": {
    "pixmix": "bin/pixmix.js"
  },
  "peerDependencies": {
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
